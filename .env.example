# Copie para .env e preencha apenas os recursos que vai usar.
# Painel, métricas, agentes e biblioteca: nenhuma chave neste arquivo é obrigatória.
# YouTube usa client_secret.json + auth.py; Claude Code usa sua própria autenticação.
# Valores do ambiente do processo têm prioridade sobre os deste arquivo.
# Use comentários em linhas separadas. $HOME não é expandido; ~/pasta é aceito nos diretórios.

# CANAL DE DESTINO — necessário para publicar via bot ou Shorts.
# Apelido usado em: .venv/bin/python auth.py principal
YT_CANAL_ALIAS=principal
# Preencha com o ID real exibido por auth.py (começa com UC).
YT_CANAL_ID=

# SHORTS — não precisam de Telegram.
# Horários HH:MM no fuso America/Sao_Paulo.
YT_SHORTS_SLOTS=09:00,18:00
# Vazio usa midias/shorts/. Pode ser ~/meus-shorts ou caminho absoluto.
YT_SHORTS_DIR=

# BOT TELEGRAM — somente se for usar esta integração.
# Token recebido do @BotFather; trate como senha.
TELEGRAM_YT_BOT_TOKEN=
# Número de message.chat.id recebido via getUpdates no seu bot.
TELEGRAM_YT_CHATID=
# Slots das aulas no fuso America/Sao_Paulo.
YT_SLOTS=10:00,16:00
# Caminho de um produtor externo compatível; não incluído no projeto.
CURSOS_IA_DIR=

# AJUSTES OPCIONAIS — os valores abaixo já são os padrões.
YT_ANTECEDENCIA_MIN=90
YT_TEMPO_PRODUCAO_MIN=240
YT_DISCO_MIN_GB=8
YT_COTA_DIA=10000
TELEGRAM_API_BASE=https://api.telegram.org

# YT_CHAT_MODELO, CLAUDE_BIN e APRESENTACAO_* são opções do terminal.
# Não são lidas automaticamente deste arquivo. Consulte o README.
